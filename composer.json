{
    "name": "lemaur/php-url-checker",
    "description": "Check the url response status code and reason phrase.",
    "license": "MIT",
    "keywords": [
        "lemaur",
        "php-url-checker",
        "checker",
        "url checker",
        "url",
        "status code"
    ],
    "authors": [
        {
            "name": "leMaur",
            "email": "hello@lemaur.me",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/lemaur/php-url-checker",
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.15.2 || ^8.0.1"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.54",
        "laravel/pint": "^1.0",
        "pestphp/pest": "^3.0 || ^4.0 || ^5.0",
        "pestphp/pest-plugin-type-coverage": "^3.0 || ^4.0 || ^5.0",
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.0",
        "roave/security-advisories": "dev-latest"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Lemaur\\UrlChecker\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lemaur\\UrlChecker\\Tests\\": "tests"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        },
        "policy": {
            "advisories": {
                "block": true
            },
            "malware": {
                "block": true,
                "block-scope": "all"
            },
            "abandoned": {
                "audit": "report"
            }
        },
        "sort-packages": true
    },
    "scripts": {
        "post-autoload-dump": "composer normalize",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint",
        "refactor": "vendor/bin/rector process",
        "test": "vendor/bin/pest",
        "test:coverage": "vendor/bin/pest --coverage --coverage-html build/coverage --coverage-text=build/coverage.txt --coverage-clover build/logs/clover.xml",
        "test:type": "vendor/bin/pest --type-coverage --log-junit=build/type-coverage.xml"
    }
}
